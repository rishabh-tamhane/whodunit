APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_PROJECT_REF=local
# Set this to the real production project ref in every deployment. Non-production
# APP_ENV values fail closed if SUPABASE_PROJECT_REF matches this value.
PRODUCTION_SUPABASE_PROJECT_REF=replace-with-production-project-ref
SERVER_CREDENTIAL_SCOPE=local
VERCEL_REGION=bom1

SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-service-role-key
OPENAI_API_KEY=replace-with-a-server-only-openai-key
OPENAI_WEBHOOK_SECRET=replace-with-an-openai-webhook-secret
HOST_RECOVERY_TOKEN_PEPPER=replace-with-at-least-32-random-characters
SAFETY_IDENTIFIER_HMAC_SECRET=replace-with-at-least-32-random-characters

STORY_MODEL=gpt-6.1-sol
STORY_ESCALATION_MODEL=gpt-6-astra
INTERVENTION_MODEL=gpt-6.1-sol
